                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/?page=1&page_size=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "5"
                }
              ]
            }
          }
        },
