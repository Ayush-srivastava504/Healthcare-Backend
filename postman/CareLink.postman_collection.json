        {
          "name": "List patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients"
