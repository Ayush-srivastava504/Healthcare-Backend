            }
          }
        },
        {
          "name": "List patients (filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/?gender=M&min_age=30&ordering=-age",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients"
              ],
              "query": [
                {
                  "key": "gender",
                  "value": "M"
                },
                {
                  "key": "min_age",
                  "value": "30"
                },
                {
                  "key": "ordering",
                  "value": "-age"
                }
              ]
            }
          }
        },
        {
          "name": "List patients (paginated)",
          "request": {
            "method": "GET",
            "header": [
