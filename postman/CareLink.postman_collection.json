            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"age\": 40,\n  \"gender\": \"M\",\n  \"blood_group\": \"O+\",\n  \"phone\": \"+40 721 000 111\",\n  \"address\": \"12 Main Street\",\n  \"medical_history\": \"Hypertension\"\n}",
              "options": {
                "raw": {
                  "language": "json"
